# Copy to .env (git-ignored). Sandbox credentials only - never real money.

# PayPal REST app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
# Filled in by `npm run setup:webhook`. When empty, webhooks are accepted UNVERIFIED (local dev only).
PAYPAL_WEBHOOK_ID=

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Protects a public demo from running up the bill
AI_DAILY_CAP=300

# Server
PORT=8787
# Public https URL PayPal can reach (webhooks, checkout return, QR codes on your phone)
PUBLIC_URL=http://localhost:8787
DB_PATH=./data/treasury.db
# Required unless DEMO_MODE=1. Owner-only API actions: "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=
# 1 = public sandbox demo: owner actions need no token, sample history is seeded when the ledger is empty
DEMO_MODE=1

# Optional: POST the approval card JSON here (forward it to your phone / chat)
APPROVAL_WEBHOOK_URL=
# Comma-separated PayPal sandbox *personal* account emails that agents "pay" (vendors)
SANDBOX_VENDOR_EMAILS=
